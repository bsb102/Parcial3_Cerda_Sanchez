# Kinesis permanece apagado hasta crear los streams y permisos IAM en AWS.
KINESIS_ENABLED=false
AWS_REGION=us-east-1
KINESIS_ENDPOINT_OVERRIDE=
KINESIS_ORDERS_STREAM_NAME=skates-orders-events
KINESIS_ORDERS_SHARD_COUNT=3
KINESIS_ORDERS_RETENTION_HOURS=24
KINESIS_ORDERS_CAPACITY_MODE=PROVISIONED
KINESIS_INVENTORY_STREAM_NAME=skates-inventory-events
KINESIS_INVENTORY_SHARD_COUNT=3
KINESIS_INVENTORY_RETENTION_HOURS=168
KINESIS_INVENTORY_CAPACITY_MODE=PROVISIONED
KINESIS_DLQ_STREAM_NAME=skates-dead-letter-stream
KINESIS_DLQ_SHARD_COUNT=1
KINESIS_DLQ_RETENTION_HOURS=168
KINESIS_DLQ_CAPACITY_MODE=PROVISIONED
KINESIS_ANALYTICS_APP_NAME=skates-analytics-app
KINESIS_NOTIFICATIONS_APP_NAME=skates-notifications-app
KINESIS_INITIAL_POSITION=LATEST
KINESIS_MAX_RETRIES=5
KINESIS_BACKOFF_INITIAL_MS=500
KINESIS_BACKOFF_MULTIPLIER=2.0
KINESIS_MAX_BACKOFF_MS=10000
KINESIS_POLLING_MAX_RECORDS=100
KINESIS_FAILOVER_TIME_MILLIS=10000
KINESIS_CONSUMER_APP=all
KINESIS_ITERATOR_AGE_THRESHOLD_MS=60000
KINESIS_ALARM_EVALUATION_PERIODS=2
KINESIS_ALARM_PERIOD=60
